PORT=5001
NODE_ENV=development

MONGO_URI=
TENANT_QUERY_ENFORCEMENT=enabled

# Comma-separated emails granted platform-owner tier (middleware/auth.js
# isPlatformOwner/requirePlatformOwner) — cross-workspace controls such as
# routes/platform.js provider availability. Leave empty in normal deployments.
PLATFORM_OWNER_EMAILS=

# Public application URLs. FRONTEND_URL is also the allowed browser origin.
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:5001
BACKEND_URL=http://localhost:5001
# Assigned automatically by Render when deployed there.
RENDER_EXTERNAL_URL=

# Optional. White-label public-site host/slug resolution (services/publicSiteService.js).
# All optional — every one falls back safely if unset. PUBLIC_FRONTEND_URL only overrides
# the referral-link base (services/ambassadorWelcomeService.js) when it differs from FRONTEND_URL.
PUBLIC_FRONTEND_URL=
PUBLIC_WORKSPACE_SLUG=
LEADPORCH_HOSTS=leadporch.co,www.leadporch.co
LEADPORCH_WORKSPACE_SLUG=leadporch
ELLIE_PUBLIC_HOSTS=
ELLIE_WORKSPACE_SLUG=ellie

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
UNSUBSCRIBE_SIGNING_SECRET=

# Eventbrite server-side connection. Keep every value below in backend/.env
# locally and in the Render backend service only.
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_EVENT_IDS=
EVENTBRITE_ORGANIZATION_ID=
EVENTBRITE_CLIENT_ID=
EVENTBRITE_CLIENT_SECRET=
EVENTBRITE_REDIRECT_URI=http://localhost:5001/api/eventbrite/oauth/callback
# Generate separately from the encryption key: openssl rand -hex 32
EVENTBRITE_WEBHOOK_TOKEN=
DEAL_TO_CLOSE_CAMPAIGN_ID=

# Use CLOUDINARY_URL when possible. The three-part form is also supported.
# Also powers the Ambassador Resource Center's private file storage
# (services/ambassadorResourceService.js) — uploaded as Cloudinary's
# "authenticated" delivery type, never publicly reachable by URL; downloads
# are proxied through a workspace-authorized backend route. Verify with
# `node scripts/ambassador-resource-smoke-test.js` before relying on it —
# this flow has not been exercised against a live account in this environment.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Apollo.io server-side API-key integration (no OAuth, no customer credentials).
# Disabled unless BOTH are set. Zero requests and zero credits are spent while disabled.
APOLLO_ENABLED=false
APOLLO_API_KEY=

# People Data Labs server-side API-key integration (no OAuth, no customer credentials).
# Disabled unless BOTH are set. Zero requests and zero credits are spent while disabled.
PDL_ENABLED=false
PDL_API_KEY=

# Legacy Google Programmable/Custom Search JSON API adapter (services/intentSourceService.js's
# google_web source). Closed to new customers and sunsets entirely on 2027-01-01 — keep this only
# as an optional legacy fallback, never the primary research source. Run
# `node scripts/google-search-smoke-test.js` to check whether a configured key/CX still works; a
# monitor that hits a 401/403 from this source is now automatically disabled for that source.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional tuning for the Reddit public-JSON research source (services/intentSourceService.js).
# Sane defaults apply if unset; each is clamped to a safe floor in code.
REDDIT_PUBLIC_CACHE_MS=
REDDIT_PUBLIC_BACKOFF_MS=
REDDIT_PUBLIC_REQUEST_GAP_MS=

# Optional Google Gemini DEVELOPER API provider (generativelanguage.googleapis.com,
# API-key auth) — fully independent of OpenAI AND of the separate Vertex AI provider
# below; any subset of the three may be enabled. Uses its OWN credential (GEMINI_API_KEY)
# — never reuses GOOGLE_SEARCH_API_KEY/GOOGLE_SEARCH_ENGINE_ID above, and never the Vertex
# AI service-account credential below. Two separate capabilities, each with its own
# platform-level switch (also requires the owning workspace to opt in and set its own
# budget under Settings; see services/geminiConfigService.js):
#   - Workspace Context: answers a question via prompt-stuffing from a workspace's OWN
#     already-approved knowledge/structured data only — never the open web, and NOT a
#     search index (that's the separate, real Vertex AI Search block further below).
#   - Grounding:    controlled public-web discovery via Gemini's Google Search grounding tool,
#     always with citations.
# Disabled by default. Zero requests and zero credits are spent while disabled. Run
# `node scripts/gemini-smoke-test.js` to verify real credentials before enabling for real use —
# this integration has not been exercised against a live Gemini endpoint.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_WORKSPACE_CONTEXT_ENABLED=false
GEMINI_GROUNDING_ENABLED=false
GEMINI_WORKSPACE_CONTEXT_MODEL=gemini-2.5-flash
GEMINI_GROUNDING_MODEL=gemini-2.5-flash

# Optional Google VERTEX AI provider — a SEPARATE Google product from the Gemini Developer
# API above: server-side service-account authentication (never an API key, never a
# frontend credential), billed to a Google Cloud project. Two independently switchable
# capabilities (see services/vertexConfigService.js for the same platform + per-workspace
# + budget gating pattern as Gemini above):
#   - Grounding:    Vertex AI Gemini + real Google Search grounding, via
#                   services/vertexGroundingService.js.
#   - Agent Search: REAL indexed, tenant-isolated retrieval over this workspace's approved
#                   Knowledge Center documents via Vertex AI Search (Discovery Engine),
#                   via services/discoveryEngineService.js. Every document is tagged with
#                   its workspaceId and every query applies a server-enforced filter on
#                   that field — no workspace can ever retrieve another's documents.
# Disabled by default; every var below is required before either capability can turn on.
# See the setup walkthrough this same edit added near the end of this file
# ("Google Cloud Console / IAM setup for Vertex AI + Discovery Engine") before configuring.
# Run `node scripts/vertex-smoke-test.js` and `node scripts/discovery-engine-smoke-test.js`
# to verify real credentials before enabling for real use — this integration has not been
# exercised against a live Google Cloud project.
VERTEX_ENABLED=false
VERTEX_GROUNDING_ENABLED=false
VERTEX_AGENT_SEARCH_ENABLED=false
# Full service-account key JSON as a single-line string (never a file path — this app never
# writes it to disk). Create a DEDICATED service account for this — see the IAM setup
# walkthrough below for exact minimal roles. Never the same key as any customer-facing OAuth
# credential above; never sent to the frontend under any circumstance.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VERTEX_PROJECT_ID=
# Region for Vertex AI Gemini generateContent calls (grounding only) — e.g. us-central1.
# This is a DIFFERENT location namespace than DISCOVERY_ENGINE_LOCATION below.
VERTEX_AI_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash-002
# Discovery Engine (Vertex AI Search) resource IDs — created once in Google Cloud Console
# (see the walkthrough below), then referenced here. DISCOVERY_ENGINE_LOCATION is almost
# always "global" for a new data store/app — it is NOT the same value as VERTEX_AI_LOCATION.
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_COLLECTION_ID=default_collection
DISCOVERY_ENGINE_DATA_STORE_ID=
DISCOVERY_ENGINE_ENGINE_ID=

# ---------------------------------------------------------------------------
# Google Cloud Console / IAM setup for Vertex AI + Discovery Engine
# (do this once per environment — e.g. once for staging, once for production)
# ---------------------------------------------------------------------------
# 1. Pick or create a Google Cloud project. Note its Project ID (not its
#    display name) — that is VERTEX_PROJECT_ID above.
#
# 2. Enable two APIs on that project (Console > APIs & Services > Library):
#      - "Vertex AI API" (aiplatform.googleapis.com) — for Grounding.
#      - "Discovery Engine API" (discoveryengine.googleapis.com) — for Agent Search.
#    Enable billing on the project; both are paid APIs.
#
# 3. Create ONE dedicated service account for this app (Console > IAM & Admin
#    > Service Accounts > Create). Do not reuse a broader existing service
#    account. Grant it exactly:
#      - roles/aiplatform.user            (Vertex Gemini generateContent calls)
#      - roles/discoveryengine.editor     (needed because this app both
#                                          indexes/removes/purges documents
#                                          AND searches — editor is a
#                                          superset of the read-only search
#                                          role; if your org requires tighter
#                                          scoping, use a custom role limited
#                                          to exactly: discoveryengine.documents.get,
#                                          .list, .create, .patch, .delete, .purge,
#                                          .import, and discoveryengine.servingConfigs.search)
#    Create a JSON key for this service account (Keys tab > Add Key > JSON),
#    then paste its full contents as ONE line into GOOGLE_APPLICATION_CREDENTIALS_JSON
#    above. Never commit this key; never send it to the frontend.
#
# 4. Create the Discovery Engine data store (Console > Agent Builder / Vertex
#    AI Search > Data Stores > Create):
#      - Type: "Unstructured documents" (generic, not "Website").
#      - Location: "global" (matches DISCOVERY_ENGINE_LOCATION default above).
#      - Content: choose the option to add documents later via API — you do
#        NOT need to import anything through the console; this app's own
#        sync (services/discoveryEngineSyncService.js) populates it from
#        approved Knowledge Center notes automatically.
#    Note the Data Store ID — that is DISCOVERY_ENGINE_DATA_STORE_ID above.
#
# 5. Create a Search App / Engine attached to that data store (same console
#    area > Apps > Create > Search). Note its Engine ID — that is
#    DISCOVERY_ENGINE_ENGINE_ID above. Leave Collection ID as the default
#    ("default_collection") unless you changed it.
#
# 6. Run the smoke tests below BEFORE enabling either capability for any real
#    workspace:
#      node scripts/vertex-smoke-test.js
#      node scripts/discovery-engine-smoke-test.js
#    The Discovery Engine smoke test's step 4 is the actual proof that one
#    workspace's documents are never returned to another's search — do not
#    treat this integration as safe to enable until that step passes.
#
# 7. Only after both smoke tests pass against this real project, set
#    VERTEX_ENABLED=true (and VERTEX_GROUNDING_ENABLED / VERTEX_AGENT_SEARCH_ENABLED
#    for whichever capability you verified), then let individual workspace
#    owners opt in under Settings > AI & Acquisition Controls.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/gmail/oauth/callback
# Generate with: openssl rand -base64 32
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=

# Twilio remains disabled until all required values are configured. Number
# purchase and A2P registration are intentionally handled outside the app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BACKEND_URL=http://localhost:5001
TWILIO_TWIML_URL=

# Coaching scheduling integrations — each optional and independently gated;
# all require INTEGRATION_CREDENTIAL_ENCRYPTION_KEY below to store a real connection.
# Google Calendar OAuth (services/googleCalendarService.js):
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5001/api/coaching/calendar/oauth/callback
# Zoom OAuth + webhook signature verification (services/zoomService.js):
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:5001/api/coaching/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
# Meetup: MEETUP_API_KEY is a separate, read-only community-search credential
# (services/meetup.js, used by audience discovery) from the OAuth pair below,
# which posts/edits real Meetup events on the connected account
# (services/meetupService.js) and stays inert unless MEETUP_OUTBOUND_ENABLED=true.
MEETUP_API_KEY=
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=
MEETUP_REDIRECT_URI=http://localhost:5001/api/meetup/oauth/callback
MEETUP_OUTBOUND_ENABLED=false

# Optional native business-data provider.
ELLIE_BUSINESS_DATA_API_URL=
ELLIE_BUSINESS_DATA_API_KEY=

# Email verification (provider-neutral canonical layer on top). Disabled unless set — no default
# paid provider is chosen for you. Emailable is the one wired-in provider today; its real
# SMTP-level "deliverable" result maps to the canonical "independently_verified" status. Each
# live verification uses credits.
EMAILABLE_API_KEY=

# X (Twitter) OAuth 2.0 PKCE. Disabled unless X_ENABLED=true AND all three below are set — even
# with real-looking credentials, X stays off until the flag is explicitly flipped.
X_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5001/api/social/x/oauth/callback
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/social/linkedin/oauth/callback
# Organization scopes require LinkedIn Community Management API access/approval.
LINKEDIN_OAUTH_SCOPES=openid profile email rw_organization_admin w_organization_social
# Required YYYYMM REST API version. Keep current as LinkedIn versions are sunset over time.
LINKEDIN_API_VERSION=YYYYMM

META_APP_ID=
META_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
META_REDIRECT_URI=http://localhost:5001/api/social/meta/oauth/callback
META_GRAPH_API_VERSION=v26.0
# Optional validation mirror only. Facebook Login for Business requests permissions
# from its Meta dashboard configuration, then Growth Operator stores actual grants.
META_OAUTH_SCOPES=pages_show_list pages_read_engagement pages_read_user_content pages_manage_metadata pages_messaging pages_manage_posts pages_manage_engagement instagram_basic instagram_manage_messages instagram_manage_comments instagram_content_publish read_insights instagram_manage_insights
META_WEBHOOK_VERIFY_TOKEN=
META_AUTOMATIC_REPLIES_ENABLED=false
SOCIAL_PUBLISHING_ENABLED=false

# Direct Instagram Login — a SEPARATE Meta login product from Facebook Login
# for Business above. Deliberately distinct app credentials, redirect path,
# scope set (instagram_business_*), and webhook verify token, so the two
# connection types remain independently authenticated and routed; see
# services/socialProviderConfig.js and services/socialOAuthService.js.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5001/api/social/instagram/oauth/callback
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic instagram_business_manage_messages instagram_business_manage_comments instagram_business_content_publish instagram_business_manage_insights
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

X_API_KEY=
X_API_SECRET=
# Do not place customer social access tokens in environment variables.
# Future social OAuth connections must store each workspace's encrypted token
# separately after that customer authorizes their own account.

# Optional Monday.com contact synchronization.
MONDAY_API_KEY=
MONDAY_CONTACTS_BOARD_ID=

# Jarvis is fully functional with its verified workspace summaries by default.
# Enable an OpenAI-written response only after you intentionally provide a key.
OPENAI_API_KEY=
JARVIS_OPENAI_ENABLED=false
JARVIS_OPENAI_MODEL=gpt-4.1-mini
JARVIS_RESEARCH_OPENAI_MODEL=gpt-5.6-sol
JARVIS_TTS_MODEL=gpt-4o-mini-tts
BUSINESS_CARD_OPENAI_MODEL=
INTENT_CLASSIFICATION_OPENAI_MODEL=

# Real OpenAI image generation. Disabled unless this AND JARVIS_OPENAI_ENABLED AND OPENAI_API_KEY
# are all set — turning on chat alone never enables paid image spend.
OPENAI_IMAGE_GENERATION_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1
MARKET_RESEARCH_AI_ENABLED=false
MARKET_RESEARCH_OPENAI_MODEL=

# Point this at the root of your local Obsidian vault. Jarvis writes notes only
# when both the path is set and this explicit opt-in is true.
OBSIDIAN_VAULT_PATH=
JARVIS_OBSIDIAN_MEMORY_ENABLED=false

# Deployed Jarvis memory: set source to cloud on Render. The local bridge uses
# this secret to push approved Markdown notes from your Mac to MongoDB.
JARVIS_MEMORY_SOURCE=local
JARVIS_MEMORY_SYNC_SECRET=
# Legacy env-var-based fallback for resolving which workspace an Obsidian sync
# belongs to, now superseded by the DB-backed VaultCredential model
# (services/vaultCredentialService.js) — only consulted if no matching
# VaultCredential exists. OBSIDIAN_WORKSPACE_ID takes precedence over
# JARVIS_MEMORY_SYNC_WORKSPACE_ID if both are set (services/jarvisMemoryService.js).
OBSIDIAN_WORKSPACE_ID=
JARVIS_MEMORY_SYNC_WORKSPACE_ID=

# Developer-only access to the software change approval queue.
DEVELOPMENT_APPROVAL_SECRET=

# Leave the mode empty to run research monitoring in the web process. Set it to
# external only when backend/worker.js is deployed separately.
RESEARCH_WORKER_MODE=
RESEARCH_WORKER_POLL_MS=
RESEARCH_WORKER_LEASE_MS=

# Same in-process-vs-external pattern as above, for three more background
# workers. Leave the *_MODE vars empty to run in the web process (the normal
# single-service deployment); set to "external" only when that worker is run
# from a separately deployed process. *_INTERVAL_MS is optional tuning (each
# clamped to a 15s floor in code); SOCIAL_PUBLISHING has a fixed 30s interval.
AUTOMATION_WORKER_MODE=
AUTOMATION_WORKER_INTERVAL_MS=
COMMUNICATION_WORKER_MODE=
COMMUNICATION_WORKER_INTERVAL_MS=
SOCIAL_PUBLISHING_WORKER_MODE=

# Optional proof-of-concept migration flag for provider-managed credentials.
INTEGRATION_CREDENTIAL_SOURCE_RESEND=

# Used only by focused integration scripts, not normal application startup.
TEST_EMAIL=

# Workspace-owned Square seller connections. Start with sandbox and keep all
# secrets server-side. These switches do not enable any automatic enrollment.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=http://localhost:5001/api/payments/square/oauth/callback
SQUARE_WEBHOOK_URL=http://localhost:5001/api/payments/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-08-19
PAYMENT_OAUTH_STATE_SECRET=

# Dead — no route or scheduled job currently calls the code that reads these.
# Confirmed by tracing every reference: services/integrations/index.js
# (IntegrationRegistry) registers FACEBOOK_ACCESS_TOKEN, INSTAGRAM_ACCESS_TOKEN,
# LINKEDIN_ACCESS_TOKEN, X_BEARER_TOKEN, and MEETUP_ACCESS_TOKEN, but that
# registry itself is never required anywhere else in the app — the real,
# live social/Meetup connections above are what's actually used.
# EMAIL_VERIFICATION_ENABLED is referenced only in a stale comment in
# services/emailVerificationService.js; the real gate there is EMAILABLE_API_KEY
# above (isEnabled() checks only that). Do not set any of these six — they have
# no effect. Listed here only so auditing this file doesn't miss them.
